###> symfony/messenger ###
# Sync transport turned for testing env for the ease of testing
OWL_MESSENGER_TRANSPORT_MAIN_DSN=doctrine://default
OWL_MESSENGER_TRANSPORT_MAIN_FAILED_DSN=doctrine://default?queue_name=main_failed
OWL_MESSENGER_TRANSPORT_ELASTICSEARCH_DSN=doctrine://default?queue_name=elasticsearch
OWL_MESSENGER_TRANSPORT_ELASTICSEARCH_FAILED_DSN=doctrine://default?queue_name=elasticsearch_failed
