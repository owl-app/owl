        "doctrine/dbal": "^3.0",
        "doctrine/doctrine-bundle": "^2.3",
        "doctrine/doctrine-migrations-bundle": "^3.1",
        "doctrine/event-manager": "^1.1",
        "doctrine/inflector": "^1.4 || ^2.0",
        "doctrine/migrations": "^3.0",
        "doctrine/orm": "^2.8",
        "doctrine/persistence": "^2.3",
        "egulias/email-validator": "^3.1",
        "elastic/ecs-logging": "*",
        "elasticsearch/elasticsearch": "^8.13",
        "fakerphp/faker": "^1.19",
        "friendsofsymfony/rest-bundle": "^3.0",
        "gedmo/doctrine-extensions": "^3.2",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.5.1",
        "jms/serializer-bundle": "^4.0",
        "knplabs/gaufrette": "^0.11",
        "knplabs/knp-gaufrette-bundle": "^0.8",
        "knplabs/knp-menu": "^3.3",
        "knplabs/knp-menu-bundle": "^3.2",
        "laminas/laminas-stdlib": "^3.7",
        "lexik/jwt-authentication-bundle": "^2.16",
        "pagerfanta/doctrine-orm-adapter": "^3.6",
        "pagerfanta/pagerfanta": "^3.0",
        "pagerfanta/twig": "^3.6",
        "psr/cache": "^2.0",
        "psr/log": "^2.0",
        "ramsey/uuid": "^4.3",
        "stof/doctrine-extensions-bundle": "^1.7",
        "sylius-labs/association-hydrator": "^1.1.3",
        "sylius-labs/doctrine-migrations-extra-bundle": "^0.1.4 || ^0.2",
        "sylius-labs/polyfill-symfony-event-dispatcher": "^1.0.1",
        "sylius-labs/polyfill-symfony-framework-bundle": "^1.0 || ^1.1",
        "sylius-labs/polyfill-symfony-security": "^1.1",
        "sylius/fixtures-bundle": "*",
        "sylius/grid": "^1.11",
        "sylius/grid-bundle": "1.13.x-dev",
        "sylius/mailer": "^1.8 || ^2.0@beta",
        "sylius/mailer-bundle": "^1.8 || ^2.0@beta",
        "sylius/money-bundle": "^1.10",
        "sylius/registry": "^1.5",
        "sylius/resource": "^1.9",
        "sylius/resource-bundle": "^1.9",
        "sylius/theme-bundle": "^2.1.1 || ^2.3",
        "symfony/asset": "^5.4 || ^6.0",
        "symfony/config": "^5.4 || ^6.0",
        "symfony/console": "^5.4 || ^6.0",
        "symfony/dependency-injection": "^5.4 || ^6.0",
        "symfony/deprecation-contracts": "3.1",
        "symfony/doctrine-bridge": "^5.4 || ^6.0",
        "symfony/doctrine-messenger": "6.4",
        "symfony/dotenv": "^5.4 || ^6.0",
        "symfony/event-dispatcher": "^5.4 || ^6.0",
        "symfony/expression-language": "^5.4 || ^6.0",
        "symfony/filesystem": "^5.4 || ^6.0",
        "symfony/finder": "^5.4 || ^6.0",
        "symfony/flex": "^2.3",
        "symfony/form": "^5.4 || ^6.0",
        "symfony/framework-bundle": "^5.4 || ^6.0",
        "symfony/http-foundation": "^5.4 || ^6.0",
        "symfony/http-kernel": "^5.4 || ^6.0",
        "symfony/intl": "^5.4 || ^6.0",
        "symfony/mailer": "^5.4 || ^6.0",
        "symfony/messenger": "^5.4 || ^6.0",
        "symfony/mime": "^5.4 || ^6.0",
        "symfony/monolog-bundle": "^3.7",
        "symfony/options-resolver": "^5.4 || ^6.0",
        "symfony/polyfill-iconv": "^1.17",
        "symfony/polyfill-intl-icu": "^1.22",
        "symfony/polyfill-mbstring": "^1.17",
        "symfony/polyfill-php80": "^1.17",
        "symfony/process": "^5.4 || ^6.0",
        "symfony/property-access": "^5.4 || ^6.0",
        "symfony/property-info": "^5.4 || ^6.0",
        "symfony/proxy-manager-bridge": "^5.4 || ^6.0",
        "symfony/routing": "^5.4 || ^6.0",
        "symfony/runtime": "^5.4 || ^6.0",
        "symfony/security-bundle": "^5.4 || ^6.0",
        "symfony/security-core": "^5.4 || ^6.0",
        "symfony/security-csrf": "^5.4 || ^6.0",
        "symfony/security-http": "^5.4 || ^6.0",
        "symfony/serializer": "^5.4 || ^6.0",
        "symfony/stopwatch": "^5.4 || ^6.0",
        "symfony/string": "^5.4 || ^6.0",
        "symfony/templating": "^5.4 || ^6.0",
        "symfony/thanks": "^1.2",
        "symfony/translation": "^5.4 || ^6.0",
        "symfony/translation-contracts": "3.3",
        "symfony/twig-bundle": "^5.4 || ^6.0",
        "symfony/validator": "^5.4 || ^6.0",
        "symfony/yaml": "^5.4 || ^6.0",
        "twig/intl-extra": "^3.3",
        "twig/twig": "^2.12 || ^3.3",
        "webmozart/assert": "^1.9",
        "winzou/state-machine": "^0.4",
        "winzou/state-machine-bundle": "^0.6",
        "yiisoft/rbac": "dev-master"
    },
    "replace": {
        "owl/admin-bundle": "self.version",
        "owl/category-bundle": "self.version",
        "owl/core-bundle": "self.version",
        "owl/file-bundle": "self.version",
        "owl/locale-bundle": "self.version",
        "owl/notification-bundle": "self.version",
        "owl/rbac-bundle": "self.version",
        "owl/rbac-manager-bundle": "self.version",
        "owl/setting-bundle": "self.version",
        "owl/status-bundle": "self.version",
        "owl/suggestion-bundle": "self.version",
        "owl/ui-bundle": "self.version",
        "owl/user-bundle": "self.version"
    },
    "conflict": {
        "jms/serializer-bundle": "3.9.0",
        "symfony/stopwatch": "^6.0"
    },    
    "require-dev": {
        "behat/behat": "^3.11",
        "behat/mink-selenium2-driver": "^1.4",
        "dmore/behat-chrome-extension": "^1.3",
        "dmore/chrome-mink-driver": "^2.7",
        "doctrine/data-fixtures": "^1.4",
        "friends-of-behat/mink": "^1.8",
        "friends-of-behat/mink-browserkit-driver": "^1.4",
        "friends-of-behat/mink-debug-extension": "^2.0",
        "friends-of-behat/mink-extension": "^2.4",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/symfony-extension": "^2.1",
        "friends-of-behat/variadic-extension": "^1.3",
        "jangregor/phpstan-prophecy": "^1.0",
        "phpspec/phpspec": "^7.3",
        "phpstan/phpstan": "^1.4",
        "phpstan/phpstan-doctrine": "^1.2",
        "phpstan/phpstan-symfony": "^1.1",
        "phpstan/phpstan-webmozart-assert": "^1.2",
        "phpunit/phpunit": "^9.5",
        "sylius-labs/coding-standard": "^4.3",
        "symfony/browser-kit": "^5.4 || ^6.0",
        "symfony/debug-bundle": "^5.4 || ^6.0",
        "symfony/web-profiler-bundle": "6.0",
        "symplify/monorepo-builder": "11.1"
    },
    "repositories": [
        {
            "type":"package",
            "package": {
              "name": "sylius/fixtures-bundle",
              "version":"master",
              "type": "package",
              "autoload": {
                "psr-4": {
                    "Sylius\\Bundle\\FixturesBundle\\": "src/"
                }
              },
              "source": {
                  "url": "https://github.com/SebLours/SyliusFixturesBundle.git",
                  "type": "git",
                  "reference":"monolog-3"
                }
            }
        }
    ],
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true,
            "symfony/thanks": true,
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    },
    "suggest": {
        "ext-iconv": "For better performance than using Symfony Polyfill Component",
        "ext-intl": "For better performance than using Symfony Polyfill Component",
        "ext-mbstring": "For better performance than using Symfony Polyfill Component"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        },
        "discovery": {
            "psr/http-factory-implementation": "GuzzleHttp\\Psr7\\HttpFactory"
        }
    },
    "autoload": {
        "psr-4": {
            "Owl\\Behat\\": "src/Owl/Behat/",
            "Owl\\Bridge\\": "src/Owl/Bridge/",
            "Owl\\Bundle\\": "src/Owl/Bundle/",
            "Owl\\Component\\": "src/Owl/Component/",
            "Yiisoft\\Rbac\\Doctrine\\": "src/Owl/Bridge/Doctrine/RbacStorage/",
            "FOS\\ElasticaBundle\\": "src/Owl/Bridge/ElasticSearchBundle/"
        },
        "exclude-from-classmap": [
            "src/Owl/*/*/Tests/",
            "src/Owl/Component/Core/Test/Tests/",
            "src/Owl/*/*/spec/",
            "src/Owl/*/*/test/",
            "src/Owl/*/*/phparkitect.php"
        ],
        "classmap": [
            "src/Kernel.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Owl\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    }
}
