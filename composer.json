        "psr/cache": "^2.0",
        "psr/log": "^2.0",
        "ramsey/uuid": "^4.3",
        "stof/doctrine-extensions-bundle": "^1.7",
        "sylius-labs/association-hydrator": "^1.1.3",
        "sylius-labs/doctrine-migrations-extra-bundle": "^0.1.4 || ^0.2",
