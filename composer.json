{
    "name": "owl/owl",
    "type": "library",
    "authors": [
        {
            "name": "Paweł Kęska",
            "email": "projekty@pawelkeska.eu"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-dom": "*",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-hash": "*",
