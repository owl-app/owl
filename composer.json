        "sylius/currency-bundle": "^2.0",
        "sylius/fixtures-bundle": "*",
        "sylius/grid": "^1.11",
        "sylius/grid-bundle": "^1.13",
        "sylius/mailer": "^1.8 || ^2.0@beta",
        "sylius/mailer-bundle": "^2.0",
        "sylius/money-bundle": "^1.10",
        "sylius/registry": "^1.5",
        "sylius/resource": "^1.13",
        "sylius/resource-bundle": "^1.13",
        "sylius/theme-bundle": "^2.4",
        "sylius/twig-extra": "^0.7.2",
        "sylius/twig-hooks": "*",
        "symfony/asset": "^6.4",
        "symfony/config": "^6.4",
        "symfony/console": "^6.4",
        "symfony/dependency-injection": "^6.4",
