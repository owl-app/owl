<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="owl.form_registry.elasticsearch_grid_filter" class="Sylius\Bundle\GridBundle\Form\Registry\FormTypeRegistry" public="false" />

        <service id="Owl\Bridge\SyliusGrid\Filter\StringFilter">
            <tag name="owl.elasticsearch_grid_filter" type="string" form-type="Sylius\Bundle\GridBundle\Form\Type\Filter\StringFilterType" />
        </service>
        <service id="sylius.elasticsearch.grid_filter.string" alias="Owl\Bridge\SyliusGrid\Filter\StringFilter" />

        <service id="Owl\Bridge\SyliusGrid\Filter\BooleanFilter">
            <tag name="owl.elasticsearch_grid_filter" type="boolean" form-type="Sylius\Bundle\GridBundle\Form\Type\Filter\BooleanFilterType" />
        </service>
        <service id="sylius.elasticsearch.grid_filter.boolean" alias="Owl\Bridge\SyliusGrid\Filter\BooleanFilter" />

        <service id="Owl\Bridge\SyliusGrid\Filter\EntityFilter">
            <tag name="owl.elasticsearch_grid_filter" type="entity" form-type="Sylius\Bundle\GridBundle\Form\Type\Filter\EntityFilterType" />
        </service>
        <service id="sylius.elasticsearch.grid_filter.entity" alias="Owl\Bridge\SyliusGrid\Filter\EntityFilter" />

    </services>
</container>
