<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <imports>
        <import resource="services/filters.xml" />
        <import resource="services/twig.xml" />
    </imports>

    <services>
        <service id="owl.resource.grid.elasticsearch_data_provider" class="Owl\Bridge\SyliusGrid\ElasticSearch\ElasticSearchDataProvider">
            <argument type="service" id="fos_elastica.registry.finder" on-invalid="ignore" />
            <argument type="service" id="owl.grid.elasticsearch_sorter" />
            <argument type="service" id="owl.grid.elasticsearch_filters_applicator" />
        </service>

        <service id="owl.registry.elasticsearch_grid_filter" class="Sylius\Component\Registry\ServiceRegistry">
            <argument>Owl\Bridge\SyliusGrid\Filtering\FilterInterface</argument>
            <argument>elasticsearch grid filter</argument>
        </service>

        <service id="Owl\Bridge\SyliusGrid\Sorting\SorterInterface" class="Owl\Bridge\SyliusGrid\Sorting\Sorter">
            <argument type="service" id="sylius.grid.sorter.validator" />
            <argument type="service" id="sylius.grid.field.validator" />
        </service>
        <service id="owl.grid.elasticsearch_sorter" alias="Owl\Bridge\SyliusGrid\Sorting\SorterInterface" />

        <service id="Owl\Bridge\SyliusGrid\Filtering\FiltersApplicatorInterface" class="Owl\Bridge\SyliusGrid\Filtering\FiltersApplicator">
            <argument type="service" id="owl.registry.elasticsearch_grid_filter" />
            <argument type="service" id="sylius.grid.filters_criteria_resolver" />
        </service>
        <service id="owl.grid.elasticsearch_filters_applicator" alias="Owl\Bridge\SyliusGrid\Filtering\FiltersApplicatorInterface" />
    </services>
</container>

