<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="owl.form.type.grid.period_filter" class="Owl\Bundle\CoreBundle\Form\Type\Grid\Filter\PeriodFilterType">
            <tag name="form.type" />
        </service>

        <service id="owl.grid_filter.period" class="Owl\Component\Core\Grid\Filter\PeriodFilter">
            
            <tag name="sylius.grid_filter" type="period" form-type="Owl\Bundle\CoreBundle\Form\Type\Grid\Filter\PeriodFilterType" />
        </service>
    </services>
</container>
