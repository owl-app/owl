<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="owl.rbac.direct_permission_user_provider" class="Owl\Bundle\CoreBundle\Rbac\DirectPermissionUserProvider">
            <argument type="service" id="owl_rbac.manager" />
            <argument type="service" id="owl_rbac.manager.storage_item" />
            <argument type="service" id="owl_rbac.manager.storage_assignment" />
        </service>

        <service 
            id="Owl\Bundle\CoreBundle\Rbac\DirectPermissionUserProviderInterface"
            alias="owl.rbac.direct_permission_user_provider"
            public="false"
        />

    </services>
</container>
