<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="Owl\Component\Core\Model\Invoice\Invoice" table="owl_invoice">

        <many-to-one field="contractor" target-entity="Owl\Component\Contractor\Model\ContractorInterface">
            <join-column name="contractor_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <many-to-one field="currency" target-entity="Sylius\Component\Currency\Model\CurrencyInterface" fetch="EAGER">
            <join-column name="currency_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

    </mapped-superclass>

</doctrine-mapping>
