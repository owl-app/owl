<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Owl\Bundle\AdminBundle\Form\Model\PasswordResetRequest">
        <property name="email">
            <constraint name="NotBlank">
                <option name="message">owl.common.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Length">
                <option name="min">2</option>
                <option name="minMessage">owl.admin.password_reset_request.email.min</option>
                <option name="max">254</option>
                <option name="maxMessage">owl.admin.password_reset_request.email.max</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Email">
                <option name="message">owl.admin.password_reset_request.email.invalid</option>
                <option name="mode">strict</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
