<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Owl\Component\Core\Model\Invoice\Invoice">
        <property name="contractor">
            <constraint name="NotNull">
                <option name="message">owl.invoice.contractor.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <property name="company">
            <constraint name="NotNull">
                <option name="message">owl.invoice.company.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <property name="currency">
            <constraint name="NotNull">
                <option name="message">owl.common.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <property name="paymentMethod">
            <constraint name="NotNull">
                <option name="message">owl.invoice.company.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        
        <property name="exchangeRateSnapshot">
            <constraint name="Valid" />
        </property>
    </class>
</constraint-mapping>