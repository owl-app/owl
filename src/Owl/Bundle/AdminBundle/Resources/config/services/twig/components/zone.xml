<?xml version="1.0" encoding="UTF-8"?>

<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service
            id="owl_admin.twig.component.zone.form"
            class="Owl\Bundle\AdminBundle\Twig\Component\Zone\FormComponent"
        >
            <argument type="service" id="owl.repository.zone" />
            <argument type="service" id="form.factory" />
            <argument>%owl.model.zone.class%</argument>
            <argument>Owl\Bundle\AdminBundle\Form\Type\ZoneType</argument>

            <tag name="owl.live_component.admin" key="owl_admin:zone:form" />
        </service>
    </services>
</container>
