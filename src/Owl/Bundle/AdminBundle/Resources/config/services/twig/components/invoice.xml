<?xml version="1.0" encoding="UTF-8"?>

<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service
            id="owl_admin.twig.component.invoice.form"
            class="Owl\Bundle\AdminBundle\Twig\Component\Invoice\FormComponent"
        >
            <argument type="service" id="owl.repository.invoice" />
            <argument type="service" id="form.factory" />
            <argument>%owl.model.invoice.class%</argument>
            <argument>Owl\Bundle\AdminBundle\Form\Type\InvoiceType</argument>
            <argument type="service" id="owl.resolver.invoice.exchange_rate_currency_resolver" />
            <argument type="service" id="owl.repository.company" />
            <argument type="service" id="owl.repository.contractor" />
            <argument type="service" id="owl.generator.invoice.invoice_number_generator" />
            <argument type="service" id="owl.registry.invoice_sequence_increment_strategy" />
            <argument type="service" id="owl.resolver.exchange_rate_resolver" />

            <tag name="owl.live_component.admin" key="owl_admin:invoice:form" />
        </service>

        <service
            id="owl_admin.twig.component.invoice.numbering.form"
            class="Owl\Bundle\AdminBundle\Twig\Component\Invoice\InvoiceNumberingComponent"
        >
        
            <argument type="service" id="ux.live_component.live_responder" />
            <argument type="service" id="form.factory" />
            <argument>Owl\Bundle\AdminBundle\Form\Type\Invoice\InvoiceNumberingType</argument>
            <argument type="service" id="owl.generator.invoice.invoice_number_generator" />

            <tag name="owl.live_component.admin" key="owl_admin:invoice:numbering:form" />
        </service>
    </services>
</container>
