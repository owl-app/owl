<?xml version="1.0" encoding="UTF-8"?>

<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service
            id="owl_admin.twig.component.suggestion.form"
            class="Owl\Bundle\UiBundle\Twig\Component\ResourceFormComponent"
        >
            <argument type="service" id="owl.repository.suggestion" />
            <argument type="service" id="form.factory" />
            <argument>%owl.model.suggestion.class%</argument>
            <argument>Owl\Bundle\SuggestionBundle\Form\Type\SuggestionType</argument>

            <tag name="owl.live_component.admin" key="owl_admin:suggestion:form" />
        </service>

        <service
            id="owl_admin.twig.component.suggestion.status.form"
            class="Owl\Bundle\UiBundle\Twig\Component\ResourceFormComponent"
        >
            <argument type="service" id="owl.repository.suggestion_status" />
            <argument type="service" id="form.factory" />
            <argument>%owl.model.suggestion_status.class%</argument>
            <argument>Owl\Bundle\CoreBundle\Form\Type\Suggestion\SuggestionStatusType</argument>

            <tag name="owl.live_component.admin" key="owl_admin:suggestion_status:form" />
        </service>

    </services>
</container>
