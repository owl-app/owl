<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <parameter key="owl.form.type.admin.password_reset_request.validation_groups" type="collection">
            <parameter>owl</parameter>
        </parameter>    
        <parameter key="owl.form.type.admin.reset_password.validation_groups" type="collection">
            <parameter>owl</parameter>
        </parameter>
    </parameters>
    
    <services>

        <service id="owl_admin.form.type.request_password_reset" class="Owl\Bundle\AdminBundle\Form\Type\RequestPasswordResetType">
            <argument>%owl.form.type.admin.password_reset_request.validation_groups%</argument>
            <tag name="form.type" />
        </service>

        <service id="owl_admin.form.type.reset_password" class="Owl\Bundle\AdminBundle\Form\Type\ResetPasswordType">
            <argument>%owl.form.type.admin.reset_password.validation_groups%</argument>
            <tag name="form.type" />
        </service>

        <service id="owl.form.type.grid_filter.ux_autocomplete" class="Owl\Bundle\AdminBundle\Form\Type\Grid\Filter\UxAutocompleteFilterType" >
            <tag name="form.type" />
            <tag name="ux.entity_autocomplete_field" />
        </service>
        <service id="owl_admin.form.type.company_autocomplete" class="Owl\Bundle\AdminBundle\Form\Type\CompanyAutocompleteType" >
            <argument>%owl.model.company.class%</argument>
            <tag name="form.type" />
            <tag name="ux.entity_autocomplete_field" />
        </service>

        <service id="owl_admin.form.type.contractor_autocomplete" class="Owl\Bundle\AdminBundle\Form\Type\ContractorAutocompleteType" >
            <argument>%owl.model.contractor.class%</argument>
            <tag name="form.type" />
            <tag name="ux.entity_autocomplete_field" />
        </service>

        <service id="owl_admin.form.type.country" class="Owl\Bundle\AdminBundle\Form\Type\CountryType" >
            <argument type="service" id="owl.repository.country" />
            <tag name="form.type" />
        </service>

        <service id="owl_admin.form.type.invoice_tax_rate" class="Owl\Bundle\AdminBundle\Form\Type\Invoice\InvoiceTaxRateType" >
            <tag name="form.type" />
        </service>

        <service id="owl_admin.form.type.zone" class="Owl\Bundle\AdminBundle\Form\Type\ZoneType" >
            <tag name="form.type" />
        </service>

        <service id="owl_admin.form.type.zone_autocomplete" class="Owl\Bundle\AdminBundle\Form\Type\ZoneAutocompleteType" >
            <argument>%owl.model.zone.class%</argument>
            <tag name="form.type" />
            <tag name="ux.entity_autocomplete_field" />
        </service>

        <service id="owl_admin.form.type.currency" class="Owl\Bundle\AdminBundle\Form\Type\CurrencyType" >
            <argument type="service" id="sylius.repository.currency" />
            <tag name="form.type" />
        </service>

        <service id="owl_admin.form.type.currency" class="Owl\Bundle\AdminBundle\Form\Type\CurrencyChoiceType" >
            <argument type="service" id="sylius.repository.currency" />
            <tag name="form.type" />
        </service>

        <service id="owl_admin.form.extension.type.location" class="Owl\Bundle\AdminBundle\Form\Extension\LocationFieldsExtension">
            <argument type="service" id="owl.form.subscriber.build_country" />
            <argument type="service" id="owl.repository.zone" />
            <tag name="form.type_extension" priority="100" />
        </service>

    </services>
</container>
