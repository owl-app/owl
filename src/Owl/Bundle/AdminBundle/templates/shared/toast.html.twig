{% set configuration = hookable_metadata.configuration %}
{% 
    set headers = {
        success: configuration.headers.success|default('owl.ui.success')|trans,
        error: configuration.headers.success|default('owl.ui.error')|trans,
    }
%}
{%  
    set icons = {
        'success': ux_icon('tabler:circle-check'),
        'error': ux_icon('tabler:exclamation-circle'),
    }
%}

<div
    class="toast-container flashes-toast-container position-fixed bottom-0 end-0 p-3"
    data-controller="toast"
    data-toast-headers-txt-value="{{ headers|json_encode }}"
    data-toast-icons-value="{{ icons|json_encode }}"
>
</div>
