{# Rendered by \Owl\Bundle\AdminBundle\TwigComponent\Shared\Navbar\NotificationsComponent #}

{% import '@OwlAdmin/shared/helper/dropdown.html.twig' as dropdown %}

<div
    class="nav-item nav-item-notification dropdown"
    data-controller="list-notification"
    data-action="details-notification:read@window->list-notification#remove"
>
    {% set dropdown_trigger %}
        <a href="#" class="nav-link px-0">
            {{ ux_icon('tabler:bell') }}
            {% if notifications %}
                <span data-list-notification-target="count" class="badge badge-sm bg-red badge-notification text-red-fg">{{ notifications|length }}</span>
            {% endif %}
        </a>
    {% endset %}

    {% set dropdown_content %}
        <div class="card" style="min-width: 25rem; max-width: 25rem">
            <div class="card-header">
                <h3 class="card-title">{{ 'owl.ui.notifications'|trans }}</h3>
            </div>
            <div class="list-group list-group-flush list-group-hoverable" data-list-notification-target="list">
                <div class="list-group-item {% if notifications is empty %} d-block {% else %}d-none{% endif %}" data-list-notification-target="empty">
                    {{ 'owl.ui.no_new_notifications'|trans }}
                </div>
                {% for notification in notifications %}
                    <div class="list-group-item" data-list-notification-target="notification" data-notification-id="{{ notification.id }}">
                        <div class="row align-items-center">
                            <div class="col">
                                <div
                                    class="d-block mt-n1"
                                    data-controller="show-modal"
                                    data-show-modal-modal-outlet=".owl-modal"
                                    data-action="click->show-modal#open"
                                    data-show-modal-url-param="{{ path('owl_admin_notification_details', { id: notification.id }) }}"
                                        data-show-modal-size-param="default"
                                >
                                    <div class="text-reset d-block mb-2">
                                        <div class="d-flex">
                                            <div class="me-auto">{{ notification.subject }}</div>
                                            <div class="badge bg-light text-light-fg date">{{ notification.createdAt|date("d-m-Y") }}</div>
                                        </div>
                                    </div>
                                    <div class="d-block text-secondary text-truncate mt-n1">
                                        {{ notification.description|striptags }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endset %}

    {{ dropdown.default({
        class: 'dropdown-menu-card dropdown-menu-arrow',
        custom_trigger: dropdown_trigger,
        content: dropdown_content,
        direction: 'down-end'
    }) }}
</div>
