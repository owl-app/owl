{% import '@OwlAdmin/shared/helper/dropdown.html.twig' as dropdown %}
{% import '@OwlAdmin/shared/helper/avatar.html.twig' as avatar %}

{% set dropdown_trigger %}
<div class="nav-link dropdown-toggle pt-1 pb-1">
    <div class="d-flex lh-1 text-reset p-0 cursor-pointer">
        <div {{ sylius_test_html_attribute('user-avatar') }}>
            {{ avatar.small() }}
        </div>
        <div class="d-none d-xl-block ps-2 pe-2 align-self-center">
            <div>{{ user.displayName|default(user.email) }}</div>
        </div>
    </div>
</div>
{% endset %}

{{ dropdown.list({ custom_trigger: dropdown_trigger, direction: 'down-end', class: 'dropdown-menu-arrow'}, menu_items) }}
