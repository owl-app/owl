{% import '@OwlAdmin/shared/helper/button.html.twig' as button %}
{% props resource = null, form = null, type = '', label = 'owl.ui.save', icon = 'tabler:trash-x', disabled = false %}
{# {% set modal_id = 'modal-form-' ~ resource.id %} #}

<div {{ attributes.defaults(stimulus_controller('modal-form')) }} {{ sylius_test_html_attribute('modal', type) }}>
    {# <div class="modal fade" id="{{ modal_id }}" tabindex="-1" aria-hidden="true"> #}

{# {{
    component(
        'owl_admin:live_open_modal',
    ) 
}} #}
{{ dump(isOpen) }}
{% if isOpen %}
    <div class="modal modal-form fade">
        <div class="modal-dialog modal-dialog-centered">
            {% block content %}
                <div class="modal-content">
                    <div class="modal-header">
                        {% block header %}
                            <h1 class="modal-title py-5">{{ 'sylius.ui.are_your_sure_you_want_to_perform_this_action'|trans }}</h1>
                        {% endblock %}
                    </div>

                    <div class="modal-body">
                        {% block body %}
                            {{ 
                                component(
                                    'owl_admin:suggestion:form', 
                                    {
                                        id: resourceId,
                                        template: '@OwlAdmin/suggestion/form.html.twig'
                                    }
                                )
                            }}
                        {% endblock %}
                    </div>

                    <div class="modal-footer">
                        {% block footer %}
                            {{ button.default({ text: 'owl.ui.cancel'|trans, attr: 'data-bs-dismiss=modal' }) }}
                            {{ button.default({ text: label|trans, type: 'submit', class: 'btn-danger', attr: sylius_test_html_attribute('confirm-button') }) }}
<button data-action="live#emit" data-live-event-param="saved">Save</button>
                        {% endblock %}
                    </div>
                </div>
            {% endblock %}
        </div>
    </div>
    {% endif %}
</div>

