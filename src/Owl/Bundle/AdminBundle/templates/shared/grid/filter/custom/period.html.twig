{% set field = hookable_metadata.configuration.field %}
{% set route = hookable_metadata.configuration.route %}
{% set activeCriteria = hookable_metadata.context.activeCriteria %}
{% set form = attribute(hookable_metadata.context.form, field) %}
{% set navigation_data = owl_period_grid_filter_generate_data_navigation(field, activeCriteria) %}

<div 
    class="col-4 d-flex filter-period ps-1 gap-2"
    {{ stimulus_controller('grid-filter-period') }}
>
    <div class="btn btn-primary p-2" data-action="click->grid-filter-period#togglePopup" data-grid-filter-period-target="button">
        {{ ux_icon('tabler:calendar', {class: 'icon mx-0'}) }}
    </div>

    {% if navigation_data.prev is defined %}
        <a
            class="btn p-2 {{ navigation_data.prev.is_disabled ? 'disabled' : '' }}"
            href="#"
            data-action="click->grid-filter-period#navigate"
            data-grid-filter-period-field-param="{{ field }}"
            data-grid-filter-period-value-param="{{ navigation_data.prev.query|json_encode }}"
        >
            {{ ux_icon('tabler:arrow-left', {class: 'icon mx-0'}) }}
        </a>
    {% endif %}

    {% if navigation_data.next is defined %}
        <a
            class="btn p-2 {{ navigation_data.next.is_disabled ? 'disabled' : '' }}"
            href="#"
            data-action="click->grid-filter-period#navigate"
            data-grid-filter-period-field-param="{{ field }}"
            data-grid-filter-period-value-param="{{ navigation_data.next.query|json_encode }}"
        >
            {{ ux_icon('tabler:arrow-right', {class: 'icon mx-0'}) }}
        </a>
    {% endif %}

    <div class="ms-2 d-flex align-items-center">
        <h2 class="text-secondary mb-0">
            {{ 'owl.ui.invoice.accounting_period'|trans }}: 
            <span class="text-dark">{{ owl_period_grid_filter_accounting_period_text(field, activeCriteria) }}</span>
        </h2>
    </div>

    <div class="card popup ms-1 d-none" data-grid-filter-period-target="filter">
        <div class="card-body d-flex">
            <div class="me-2">
                {{ form_row(form.type, { label: false, row_attr: { class: 'mb-0' }}) }}
            </div>
    
            {% if form.month is defined %}
                <div class="me-2">
                    {{ form_row(form.month, { label: false, row_attr: { class: 'mb-0' }}) }}
                </div>
            {% endif %}
    
            {% if form.quarter is defined %}
                <div class="me-2">
                    {{ form_row(form.quarter, { label: false, row_attr: { class: 'mb-0' }}) }}
                </div>
            {% endif %}

            {% if form.year is defined %}
                <div class="me-2">
                    {{ form_row(form.year, { label: false, row_attr: { class: 'mb-0' }  })}}
                </div>
            {% endif %}

            <button class="btn btn-primary" data-action="click->grid-filter#updateFilter" data-grid-filter-field-param="issueDate">
                {{ 'owl.ui.confirm'|trans }}
            </button>
        </div>
    </div>
</div>

