{% set route = options.link.url|default(options.link.route) %}
{% set path = options.link.url|default(path(options.link.route, options.link.parameters|default({'id': data.id}))) %}

{% if is_granted(route) %}
    <a href="{{ path }}" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="{{ action.label|trans }}">
        {{ ux_icon(options.icon|default('flowbite:check-plus-circle-outline')) }}
    </a>
{% endif %}
