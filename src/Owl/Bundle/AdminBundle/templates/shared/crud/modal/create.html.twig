{% set prefixes = configuration.vars.hook_prefix is defined ? [configuration.vars.hook_prefix] %}
{% set prefixes = prefixes|default({})|merge([
    'owl_admin.%resource_name%.modal'|replace({'%resource_name%': resource_name|default(metadata.name)}),
    'owl_admin.common.modal'
]) %}

{% block content %}
    {% hook 'create' with { _prefixes: prefixes, resource, metadata, configuration, form } %}
{% endblock %}

{% block stylesheets %}
    {% hook 'create#stylesheets' with { _prefixes: prefixes } %}
{% endblock %}

{% block javascripts %}
    {% hook 'create#javascripts' with { _prefixes: prefixes } %}
{% endblock %}
