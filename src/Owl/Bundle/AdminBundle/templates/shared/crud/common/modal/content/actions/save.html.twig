{% import '@OwlAdmin/shared/helper/button.html.twig' as button %}

{% set configuration = hookable_metadata.configuration %}

{% set saveActionParam = configuration.params.save_action|default('referer') %}
{% set method = configuration.method|default('POST') %}

{% block button %}
    {% if path is not defined %}
        {% set path = path(configuration.path.route, configuration.path.params|default({})) %}
    {% endif %}

    {{ button.primary(
        { 
            text: 'owl.ui.save'|trans,
            attr: {
                'data-action': 'form:saved@window->modal#close form#save',
                'data-form-url-param': path,
                'data-form-method-param': method,
                'data-form-save-action-param': saveActionParam
            }|merge(
                hookable_metadata.configuration.button.attributes|default({'data-form-target' : 'action'})
            )
        }
    ) }}
{% endblock %}