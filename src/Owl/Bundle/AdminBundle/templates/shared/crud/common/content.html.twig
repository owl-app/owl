{% set controllerNames = [] %}
{% set controllerValues = [] %}

{% set metadata = hookable_metadata.context.metadata %}
{% set page_wrapper_class = hookable_metadata.configuration.page_wrapper_class|default(metadata.applicationName ~ '-page-wrapper-' ~ _context.metadata.name)|replace({'_': '-'}) %}

{% if hookable_metadata.configuration.stimulus.controllers is defined %}
    {% for controllerName, options in hookable_metadata.configuration.stimulus.controllers %}
        {% set controllerNames = controllerNames|merge([controllerName]) %}

        {% if options.values is defined %}
            {% for valueName, valueContent in options.values %}
                {% set controllerValues = controllerValues|merge([{
                    name: 'data-' ~ controllerName ~ '-'  ~ valueName ~ '-value',
                    value: valueContent is iterable ? valueContent|json_encode : valueContent
                }]) %}
            {% endfor %}
        {% endif %}

    {% endfor %}
{% endif %}

<div 
    class="page-wrapper {{ page_wrapper_class}}"
    {% if controllerNames is not empty %} {{ stimulus_controller(controllerNames|join(' ')) }} {% endif %}
    {% if controllerValues is not empty %}
        {% for controllerValue in controllerValues %}
            {{ controllerValue.name }}='{{ controllerValue.value }}'
        {% endfor %}
    {% endif %}
>
    {% hook 'content' %}
</div>