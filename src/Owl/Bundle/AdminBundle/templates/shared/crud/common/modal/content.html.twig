
{% set controller_names = [] %}
{% set controller_values = [] %}
{% set controller_outlets = [] %}
{% set class = [hookable_metadata.configuration.class|default('')]|merge(['modal-content', 'fade'])|join('  ') %}

{% if hookable_metadata.configuration.stimulus.controllers is defined %}
    {% for controller_name, options in hookable_metadata.configuration.stimulus.controllers %}
        {% set controller_names = controller_names|merge([controller_name]) %}

        {% if options.values is defined %}
            {% for value_name, value_content in options.values %}
                {% set controller_values = controller_values|merge([{
                    name: 'data-' ~ controller_name ~ '-'  ~ value_name ~ '-value',
                    value: value_content is iterable ? value_content|json_encode : value_content
                }]) %}
            {% endfor %}
        {% endif %}

        {% if options.outlets is defined %}
            {% for outlet_name, outlet_value in options.outlets %}
                {% set controller_outlets = controller_outlets|merge([{
                    name: 'data-' ~ controller_name ~ '-'  ~ outlet_name ~ '-outlet',
                    value: outlet_value,
                }]) %}
            {% endfor %}
        {% endif %}

    {% endfor %}
{% endif %}

<div 
    data-modal-target="content"
    class="{{ class }}"
    {% if controller_names is not empty %} {{ stimulus_controller(controller_names|join(' ')) }} {% endif %}

    {% if hookable_metadata.configuration.stimulus.actions is defined %}
        data-action="{{ hookable_metadata.configuration.stimulus.actions|join(' ') }}"
    {% endif %}

    {% if controller_values is not empty %}
        {% for controllerValue in controller_values %}
            {{ controllerValue.name }}='{{ controllerValue.value }}'
        {% endfor %}
    {% endif %}

    {% if controller_outlets is not empty %}
        {% for controller_outlet in controller_outlets %}
            {{ controller_outlet.name }}='{{ controller_outlet.value }}'
        {% endfor %}
    {% endif %}
>
    {% hook 'content' %}
</div>