{% set prefixes = hookable_metadata.context.configuration.vars.hook_prefix is defined ? [hookable_metadata.context.configuration.vars.hook_prefix] %}
{% set prefixes = prefixes|default({})|merge([
    'owl_admin.%resource_name%'|replace({'%resource_name%': resource_name|default(hookable_metadata.context.metadata.name)}),
]) %}

{{ dump(prefixes)}}

{% 
    hook 'modal' with { 
        _prefixes: prefixes,
        metadata: hookable_metadata.context.metadata,
        resources: hookable_metadata.context.resources,
    } 
%}