{% macro render_hidden_custom_filters_inputs(namePrefix, data) %}
    {% import _self as self %}
    {% for key, value in data %}
        {% set fullName = namePrefix ~ '[' ~ key ~ ']' %}
        {% if value is iterable and value is not same as(null) %}
            {{ self.render_hidden_custom_filters_inputs(fullName, value) }}
        {% else %}
            <input type="hidden" name="{{ fullName }}" value="{{ value }}">
        {% endif %}
    {% endfor %}
{% endmacro %}