{%- macro format(amount, currency) -%}
    {{ amount|sylius_format_money(currency, app.user.localeCode) }}
{%- endmacro -%}

{%- macro convertAndFormat(amount, fromCurrency, toCurrency) -%}
    {% from _self import format %}

    {{- format(amount|sylius_convert_money(toCurrency, fromCurrency), toCurrency) }}
{%- endmacro -%}
