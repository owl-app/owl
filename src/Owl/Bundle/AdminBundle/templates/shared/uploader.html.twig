{% set configuration = hookable_metadata.configuration %}
{% set path = path(configuration.path.route, configuration.path.params) %}

<div
    class="owl-uploader"
    data-controller="uploader"
    data-uploader-url-value="{{ path }}"
    data-uploader-replace-value="{{ configuration.replace|default('id') }}"
    data-action="{{ configuration.action }}"
>
    {% hook 'owl_admin.common.component.uploader' with { _prefixes: [] } %}
</div>


