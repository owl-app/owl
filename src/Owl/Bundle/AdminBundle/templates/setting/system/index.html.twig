{% extends '@OwlAdmin/shared/layout/base.html.twig' %}

{% set prefixes = [
    'owl_admin.system_setting'
] %}

{% block title %}{{ 'owl.ui.system_settings'|trans }} | {{ parent() }}{% endblock %}

{% block body_class %}layout-fluid{% endblock %}

{% block body %}
    {% hook 'index' with { _prefixes: prefixes, configuration, form } %}
{% endblock %}

{% block modal %}
    {% hook 'index#modals' with { _prefixes: prefixes, configuration, form } %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% hook 'index#stylesheets' with { _prefixes: prefixes } %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% hook 'index#javascripts' with { _prefixes: prefixes } %}
{% endblock %}
