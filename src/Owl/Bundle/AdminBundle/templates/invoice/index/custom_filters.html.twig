{% form_theme form '@OwlAdmin/shared/form_theme.html.twig' %}

<div class="owl-custom-filters" {{ attributes.defaults(stimulus_controller('grid-filter')) }}>
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {% hook 'form' with { form } %}
            <div class="col-2">
                <button class="btn btn-primary" data-action="click->grid-filter#change" data-grid-filter-field-param="issueDate">
                    {{ 'owl.ui.confirm'|trans }}
                </button>
            </div>
    {{ form_end(form, {render_rest: hookable_metadata.configuration.render_rest|default(false)}) }}
</div>
