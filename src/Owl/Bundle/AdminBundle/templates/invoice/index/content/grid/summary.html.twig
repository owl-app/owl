{% import '@OwlAdmin/shared/helper/money.html.twig' as money %}

{% set resources = hookable_metadata.context.resources %}
{% set data = resources.data %}
{% set summary = owl_invoices_summary(resources.definition.code, resources.data) %}

{% if summary|length > 0 %}
    <div class="d-flex justify-content-end mt-3 mb-4">
        <div class=" w-25 text-end">
            <div class="card mt-1">
                <div class="card-status-start bg-primary"></div>
                <div class="card-header justify-content-end">
                    <h3 class="card-title">{{ 'owl.ui.invoice.summary'|trans }}</h3>
                </div>
                <div class="card-body">
                    <div class="d-flex">
                        <div class="w-50">
                            <h4 class="mb-2">{{ 'owl.ui.invoice.net_total'|trans }}:</h4>
                        </div>
                        <div class="w-50 text-right">
                            {{ money.format(summary.subtotal, summary.currency) }}
                        </div>
                    </div>
                    <div class="d-flex">
                        <div class="w-50">
                            <h4 class="mb-2">{{ 'owl.ui.invoice.tax_total'|trans }}:</h4>
                        </div>
                        <div class="w-50 text-right">
                            {{ money.format(summary.tax, summary.currency) }}
                        </div>
                    </div>
                    <div class="d-flex align-items-end">
                        <div class="w-50">
                            <h2 class="mb-0">{{ 'owl.ui.invoice.gross_total'|trans }}:</h2>
                        </div>
                        <div class="w-50 text-right">
                            <h2 class="mb-0">
                                {{ money.format(summary.total, summary.currency) }}
                            </h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
