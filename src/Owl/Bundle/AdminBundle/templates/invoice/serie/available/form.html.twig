{% import '@OwlUi/macro/messages.html.twig' as messages %}

{% set series = hookable_metadata.context.series %}
{% set replacesForamt = 
    {
        '__NUMBER__': '<span class="badge bg-lime-lt text-dark ms-1 me-1 pt-2 pb-2">' ~ 'owl.ui.number'|trans ~ '</span>',
        '__MM__': '<span class="badge bg-azure-lt text-dark ms-1 me-1 pt-2 pb-2">' ~ 'owl.ui.month'|trans ~ ' - MM </span>',
        '__YYYY__': '<span class="badge bg-purple-lt text-dark ms-1 me-1 pt-2 pb-2">' ~ 'owl.ui.year'|trans ~ ' - YYYY </span>'
    }
%}

{% if series|length > 0 %}
    {% for serie in series %}
        <div class="col-12 d-flex border-bottom mb-3">
            <div class="form-check d-flex align-items-center me-auto">
                <input
                    data-next-counter="{{ serie.nextCounter }}"
                    data-next-value="{{ serie.nextValue }}"
                    data-format-id="{{ serie.id }}"
                    data-format="{{ serie.format }}"
                    data-invoice-available-series-target="serieRadio"
                    class="form-check-input"
                    type="radio"
                    name="format"
                    id="format_{{ serie.id }}"
                >
                <label class="form-check-label d-flex align-items-center ms-2" for="format_{{ loop.index }}">
                    {{ serie.format|replace(replacesForamt)|raw }}
                </label>
                <small class="text-secondary">
                    <em>({{ ('owl.ui.invoice.increment.' ~ serie.sequenceIncrement)|trans }})</em>
                </small>
            </div>
            <div class="d-flex align-items-center text-secondary lead">
                <small>{{ 'owl.ui.system'|trans }}</small>
            </div>
        </div>
    {% endfor %}
    <div class="col-12 d-flex border-bottom mb-3">
        <div class="form-check d-flex align-items-center me-auto">
            <input
                data-next-counter=""
                data-next-value=""
                data-format-id=""
                data-format=""
                data-invoice-available-series-target="serieRadio"
                class="form-check-input"
                type="radio"
                name="format"
                id="format_disabled"
            >
            <label class="form-check-label d-flex align-items-center ms-2" for="format_disabled">
                {{ 'owl.ui.turn_off_automatic_numbering_for_this_invoice'|trans }}
            </label>
        </div>
        <div class="d-flex align-items-center text-danger lead">
            <small>{{ 'owl.ui.not_recommended'|trans }}</small>
        </div>
    </div>
{% else %}
    {{ messages.info('owl.ui.no_results_to_display') }}
{% endif %}

<div class="d-flex align-items-center">
    <div class="field field-invoice-number me-5">
        <label class="form-label required">{{ 'owl.ui.number'|trans }}</label>
        <input type="number" required="required" data-test-address="" class="form-control number-invoice" data-invoice-available-series-target="valueSequenceNumber">
        <div class="invalid-feedback d-none">{{ 'owl.common.not_blank'|trans(domain = 'validators') }}</div>
    </div>
    <div class="field field-peview d-flex align-items-center" data-invoice-available-series-target="previewNumberBox">
        <div class="d-flex align-items-center">
            <strong>{{ 'owl.ui.preview'|trans }}:</strong>
            <span class="badge bg-lime-lt text-dark ms-2 me-1 pt-2 pb-2" data-invoice-available-series-target="previewNumberText"></span>
        </div>
    </div>
    <div class="field" style="width: 200px" data-invoice-available-series-target="fullNumberBox">
        <label class="form-label required">{{ 'owl.ui.full_number'|trans }}</label>
        <input type="text" required="required" data-test-address="" class="form-control" data-invoice-available-series-target="valueFullNumber">
        <div class="invalid-feedback d-none">{{ 'owl.common.not_blank'|trans(domain = 'validators') }}</div>
    </div>
</div>