{% if form is not defined %}
    {% set form = hookable_metadata.context.form %}
{% endif %}

{% if resource is not defined %}
    {% set resource = hookable_metadata.context.resource|default(null) %}
{% endif %}

{% form_theme form '@OwlAdmin/shared/form_theme.html.twig' %}

<div {% if attributes is defined %} {{ attributes }} data-form-target="live" {% endif %}>
    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': form.vars.id, 'data-form-target':'form'}}) }}
        {{ form_errors(form) }}
        {{ form_widget(form._token) }}

        {% hook 'form' with { form, resource } %}
    {{ form_end(form, {render_rest: hookable_metadata.configuration.render_rest|default(false)}) }}
</div>
