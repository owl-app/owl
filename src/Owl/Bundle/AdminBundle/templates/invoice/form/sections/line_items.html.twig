{% import '@OwlAdmin/shared/helper/money.html.twig' as money %}

{% if hookable_metadata.context.form.lineItems is defined %}
<div class="d-flex justify-content-end gap-5 mt-4">
    <div>
        {{ form_label(hookable_metadata.context.form.calculateValuesFrom) }}
    </div>
    {{ 
        form_widget(hookable_metadata.context.form.calculateValuesFrom, sylius_test_form_attribute('calculate-values-form')) 
    }}
</div>

<table class="table table-line-items card-table table-vcenter datatable col-12 box">
    <thead>
        <tr>
            <th style="width:30%">
                {{ 'owl.invoice.line_item.name'|trans }}
            </th>
            <th style="width: 100px">
                {{ 'owl.invoice.line_item.quantity'|trans }}
            </th>
            <th style="width: 120px">
                {{ 'owl.invoice.line_item.unit'|trans }}
            </th>
            {% if hookable_metadata.context.form.calculateValuesFrom.vars.value == 'net' %}
                <th style="width: 200px">
                    {{ 'owl.invoice.line_item.unit_price'|trans }}
                </th>
                <th style="width: 200px">
                    {{ 'owl.invoice.line_item.net_value'|trans }}
                </th>
            {% endif %}
            {% if hookable_metadata.context.form.calculateValuesFrom.vars.value == 'gross' %}
                <th style="width: 200px">
                    {{ 'owl.invoice.line_item.unit_gross_price'|trans }}
                </th>
                <th style="width: 200px">
                    {{ 'owl.invoice.line_item.gross_value'|trans }}
                </th>
            {% endif %}
            <th style="width: 170px">
                {{ 'owl.invoice.line_item.tax_rate.label'|trans }}
            </th>
            <th>
                {{ 'owl.ui.invoice.line_item.tax_value'|trans }}
            </th>
            {% if hookable_metadata.context.form.calculateValuesFrom.vars.value == 'net' %}
                <th>
                    {{ 'owl.invoice.line_item.gross_value'|trans }}
                </th>
            {% endif %}
            {% if hookable_metadata.context.form.calculateValuesFrom.vars.value == 'gross' %}
                <th>
                    {{ 'owl.invoice.line_item.net_value'|trans }}
                </th>
            {% endif %}
            <th>
            </th>
        </tr>
    </thead>
    <tbody {{ sylius_test_html_attribute('line-items') }}>
        {% for key, line_item_form in hookable_metadata.context.form.lineItems %}
            {% set item = line_item_form.vars.data %}
            <tr>
                <td>
                    {{ form_widget(line_item_form.name, sylius_test_form_attribute('line-item-name')) }}
                </td>
                <td>
                    {{
                        
                        form_widget(line_item_form.quantity, sylius_test_form_attribute('line-item-quantity')|merge(
                            {
                                row_attr: { class: 'mb-2' },
                                attr: {
                                    'data-action': 'keyup->invoice-form#quantityChanged',
                                    'data-invoice-form-key-param': key,
                                    'data-model': 'norender|' ~ line_item_form.quantity.vars.full_name,
                                }
                            }
                        ))
                    }}
                </td>
                <td>
                    {{ form_widget(line_item_form.unit, sylius_test_form_attribute('line-item-unit')) }}
                </td>
                <td>
                    {{
                        form_widget(line_item_form.unitPrice, sylius_test_form_attribute('line-item-unit-net-price')|merge(
                            {
                                row_attr: { class: 'mb-2' },
                                attr: {
                                    'data-action': 'keyup->invoice-form#unitPriceChanged',
                                    'data-invoice-form-key-param': key,
                                    'data-model': 'norender|' ~ line_item_form.unitPrice.vars.full_name,
                                }
                            }
                        ))
                    }}
                </td>
                <td>
                    {{
                        form_widget(line_item_form.totalPrice, sylius_test_form_attribute('line-item-sum-price')|merge(
                            {
                                row_attr: { class: 'mb-2' },
                                attr: {
                                    'data-action': 'change->invoice-form#sumChanged',
                                    'data-invoice-form-key-param': key,
                                }
                            }
                        ))
                    }}
                </td>
                <td>
                    {{ form_widget(line_item_form.taxRate, sylius_test_form_attribute('line-item-tax-rate')) }}
                </td>
    
                {% if hookable_metadata.context.form.calculateValuesFrom.vars.value == 'net' %}
                    <td>
                        {{ money.format(item.taxTotal, hookable_metadata.context.form.currency.vars.value) }}
                    </td>
                    <td>
                        {{ money.format(item.total, hookable_metadata.context.form.currency.vars.value) }}
                    </td>
                {% endif %}

                {% if hookable_metadata.context.form.calculateValuesFrom.vars.value == 'gross' %}
                    <td>
                        {{ money.format(item.taxTotal, hookable_metadata.context.form.currency.vars.value) }}
                    </td>
                    <td>
                        {{ money.format(item.subtotal, hookable_metadata.context.form.currency.vars.value) }}
                    </td>
                {% endif %}
                <td class="col-auto" {{ sylius_test_html_attribute('delete-line-item') }}>
                    {{ form_row(line_item_form.vars.button_delete) }}
                </td>
            </tr>
            {% if line_item_form.snapshotNameOverwrite is defined or line_item_form.snapshotAmountOverwrite is defined  %}
                <tr>
                    <td colspan="9" class="text-end">
                        {% if line_item_form.snapshotNameOverwrite is defined %}
                            <div class="d-flex justify-content-end">
                                {{ 
                                    form_widget(
                                        line_item_form.snapshotNameOverwrite,
                                        sylius_test_form_attribute('line-item-tax-rate-snapshot-name-overwrite')|merge(
                                            {
                                                label_attr: { style: 'min-width: 260px' }
                                            }
                                        )
                                ) }}
                            </div>
                        {% endif %}
                        {% if line_item_form.snapshotAmountOverwrite is defined %}
                            <div class="d-flex justify-content-end">
                                {{ 
                                    form_widget(
                                        line_item_form.snapshotAmountOverwrite,
                                        sylius_test_form_attribute('line-item-tax-rate-snapshot-amount-overwrite')|merge(
                                            {
                                                label_attr: { style: 'min-width: 260px' }
                                            }
                                        )
                                ) }}
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% endif %}
        {% endfor %}
    </tbody>
</table>

<div class="row ms-2">
    {{ form_widget(hookable_metadata.context.form.lineItems.vars.button_add, sylius_test_form_attribute('add-line-item')) }}
</div>
{% endif %}