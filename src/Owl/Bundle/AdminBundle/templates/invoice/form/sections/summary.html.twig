{% import '@OwlAdmin/shared/helper/money.html.twig' as money %}

{% if hookable_metadata.context.form.lineItems is defined %}

{% set invoice = hookable_metadata.context.form.vars.data %}
{% set selectedCurrency = hookable_metadata.context.form.currency.vars.value %}

{% if hookable_metadata.context.exchangeRateCurrency is defined %}
    {% set exchangeRateCurrency = hookable_metadata.context.exchangeRateCurrency %}
{% endif %}

<div class="d-flex justify-content-end">
    {% if exchangeRateCurrency is defined and exchangeRateCurrency is not empty and selectedCurrency is not empty %}
        <div class="w-25 text-end me-5">
            <div class="card mt-1">
                <div class="card-status-start bg-blue"></div>
                <div class="card-header justify-content-end">
                    <div class="col-5 d-flex flex-row">
                        <div class="w-75 fs-1 d-flex align-items-center">
                            {{ 
                                form_label(
                                    hookable_metadata.context.form.exchangeRateSnapshot.ratio,
                                    'owl.ui.invoice.exchange_rate'|trans, 
                                    { label_attr: {class : 'fs-5 text mb-0 d-flex'}}
                                )
                            }}
                        </div>
                        <div class="w-25">
                            {{
                                form_widget(
                                    hookable_metadata.context.form.exchangeRateSnapshot.ratio,
                                    sylius_test_form_attribute('exchange-rate-snapshot-ratio')|merge(
                                        {
                                            attr: { class: 'form-control-sm' },
                                        }
                                    )
                                )
                            }}
                        </div>
                    </div>
                    <h4 class="col-7 mb-0 flex align-items-center">
                        {{ 'owl.ui.invoice.conversion_of_amounts'|trans({'%currencyFrom%': selectedCurrency, '%currencyTo%': exchangeRateCurrency}) }}
                    </h4>
                </div>
                <div class="card-body">
                    
                    <div class="d-flex">
                        <div class="w-50">
                            <h4 class="mb-2">{{ 'owl.ui.invoice.net_total'|trans }}:</h4>
                        </div>
                        <div class="w-50 text-right">
                            {{ money.format(invoice.subtotalConverted, exchangeRateCurrency) }}
                        </div>
                    </div>
                    <div class="d-flex">
                        <div class="w-50">
                            <h4 class="mb-2">{{ 'owl.ui.invoice.tax_total'|trans }}:</h4>
                        </div>
                        <div class="w-50 text-right">
                            {{ money.format(invoice.taxTotalConverted, exchangeRateCurrency) }}
                        </div>
                    </div>
                    <div class="d-flex align-items-end">
                        <div class="w-50">
                            <h2 class="mb-0">{{ 'owl.ui.invoice.gross_total'|trans }}:</h2>
                        </div>
                        <div class="w-50 text-right">
                            <h2 class="mb-0">
                                {{ money.format(invoice.totalConverted, exchangeRateCurrency) }}
                            </h2>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    {% endif %}
    <div class=" w-25 text-end">
        <div class="card mt-1">
            <div class="card-status-start bg-primary"></div>
            <div class="card-header justify-content-end">
                <h3 class="card-title">{{ 'owl.ui.invoice.summary'|trans }}</h3>
            </div>
            <div class="card-body">
                <div class="d-flex">
                    <div class="w-50">
                        <h4 class="mb-2">{{ 'owl.ui.invoice.net_total'|trans }}:</h4>
                    </div>
                    <div class="w-50 text-right">
                        {{ money.format(invoice.subtotal, selectedCurrency) }}
                    </div>
                </div>
                <div class="d-flex">
                    <div class="w-50">
                        <h4 class="mb-2">{{ 'owl.ui.invoice.tax_total'|trans }}:</h4>
                    </div>
                    <div class="w-50 text-right">
                        {{ money.format(invoice.taxTotal, selectedCurrency) }}
                    </div>
                </div>
                <div class="d-flex align-items-end">
                    <div class="w-50">
                        <h2 class="mb-0">{{ 'owl.ui.invoice.gross_total'|trans }}:</h2>
                    </div>
                    <div class="w-50 text-right">
                        <h2 class="mb-0">
                            {{ money.format(invoice.total, selectedCurrency) }}
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endif %}

