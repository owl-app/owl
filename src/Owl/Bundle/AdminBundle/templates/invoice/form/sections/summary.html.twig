{% import '@OwlAdmin/shared/helper/money.html.twig' as money %}

{% set invoice = hookable_metadata.context.form.vars.data %}

<div class="d-flex justify-content-end">
    <div class="card w-25 text-end">
        <div class="card-status-start bg-primary"></div>
        <div class="card-body">
            <p class="text-secondary">
                <div class="d-flex">
                    <div class="w-50">
                        <h4 class="mb-2">{{ 'owl.ui.invoice.net_total'|trans }}:</h4>
                    </div>
                    <div class="w-50 text-right">
                        {{ money.format(invoice.subtotal, hookable_metadata.context.form.currency.vars.value) }}
                    </div>
                </div>
                <div class="d-flex">
                    <div class="w-50">
                        <h4 class="mb-2">{{ 'owl.ui.invoice.tax_total'|trans }}:</h4>
                    </div>
                    <div class="w-50 text-right">
                        {{ money.format(invoice.taxTotal, hookable_metadata.context.form.currency.vars.value) }}
                    </div>
                </div>
                <div class="d-flex">
                    <div class="w-50">
                        <h2>{{ 'owl.ui.invoice.gross_total'|trans }}:</h2>
                    </div>
                    <div class="w-50 text-right">
                        {{ money.format(invoice.total, hookable_metadata.context.form.currency.vars.value) }}
                    </div>
                </div>
            </p>
        </div>
    </div>
</div>

