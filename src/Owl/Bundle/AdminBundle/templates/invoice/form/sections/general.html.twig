{% for error in hookable_metadata.context.form.sequenceNumber.vars.errors %}
    <div class="text-red-600 text-sm">
        {{ error.message }}

        {% set cause = error.cause %}
        {% if cause is iterable %}
            <pre>{{ dump(cause) }}</pre> {# albo użyj konkretnych danych #}
        {% endif %}
    </div>
{% endfor %}

<div class="row">
    <div class="col-6">
        {{
            form_row(hookable_metadata.context.form.sequenceNumber, sylius_test_form_attribute('sequenceNumber')|merge(
                {
                    row_attr: { class: 'mb-2' },
                    attr: {
                        'data-invoice-form-target': 'sequenceNumber',
                    }
                }
            ))
        }}
    </div>
</div>

<div class="row">
    <div class="col-6">
        {{
            form_row(hookable_metadata.context.form.fullNumber, sylius_test_form_attribute('fullNumber')|merge(
