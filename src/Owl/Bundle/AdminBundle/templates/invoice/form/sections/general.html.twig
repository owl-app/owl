<div class="col-12 col-lg-6 box pe-5">
    <h3 class="text-primary border-bottom border-primary pb-1">{{ 'owl.ui.general'|trans }}</h3>
    {% for error in hookable_metadata.context.form.sequenceNumber.vars.errors %}
        <div class="text-red-600 text-sm">
            {{ error.message }}

            {% set cause = error.cause %}
            {% if cause is iterable %}
                {# <pre>{{ dump(cause) }}</pre> #}
            {% endif %}
        </div>
    {% endfor %}

    <div class="row">
        <div class="col-lg-6">
            {{ form_row(hookable_metadata.context.form.company, owl_test_form_attribute('company')) }}
        </div>
        <div class="col-lg-6">
            {{ form_row(hookable_metadata.context.form.contractor, owl_test_form_attribute('contractor')) }}
        </div>
    </div>

    <div class="row">
        <div class="col-6">
            {{
                form_row(hookable_metadata.context.form.issueDate, owl_test_form_attribute('issue-date')|owl_replace_recursive(
                    {
                        row_attr: { class: 'mb-2' },
                        attr: {
                            'data-invoice-form-target': 'issueDate',
                        }
                    }
                ))
            }}
        </div>

        <div class="col-6">
            {{ form_row(hookable_metadata.context.form.transactionDate, owl_test_form_attribute('transaction-date')|merge({row_attr: { class: 'mb-2' }})) }}
        </div>
    </div>

    {{ form_row(hookable_metadata.context.form.fullNumber, owl_test_form_attribute('fullNumber')|merge({ row_attr: { class: 'mb-2' } })) }}
    {{ form_row(hookable_metadata.context.form.sequenceNumber, owl_test_form_attribute('sequenceNumber')|merge({ row_attr: { class: 'mb-2' } })) }}
    {{ form_row(hookable_metadata.context.form.serie, owl_test_form_attribute('serie')|merge({ row_attr: { class: 'mb-2' } })) }}
</div>