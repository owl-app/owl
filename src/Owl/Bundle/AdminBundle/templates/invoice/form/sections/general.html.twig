</div>

<div class="row">
    <div class="col-6">
        {{ form_row(hookable_metadata.context.form.buyer.contractor, sylius_test_form_attribute('buyer.contractor')|merge({ row_attr: { class: 'mb-2' }})) }}
    </div>
</div>

<div class="row">
    <div class="col-3">
        {{
            form_row(hookable_metadata.context.form.issueDate, sylius_test_form_attribute('issueDate')|merge(
                {
