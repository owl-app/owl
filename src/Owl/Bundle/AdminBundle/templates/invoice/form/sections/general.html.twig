    </div>
    <div class="col-3">
        {{ form_row(hookable_metadata.context.form.transactionDate, sylius_test_form_attribute('transactionDate')|merge({ row_attr: { class: 'mb-2' }})) }}
    </div>
    <div class="col-3">
        {{ form_row(hookable_metadata.context.form.duePaymentDate, sylius_test_form_attribute('duePaymentDate')|merge({ row_attr: { class: 'mb-2' }})) }}
    </div>
    {{
        form_row(hookable_metadata.context.form.serie, sylius_test_form_attribute('serie')|merge(
            {
                row_attr: { class: 'mb-2' },
                attr: {
                    'data-invoice-form-target': 'serie',
                }
            }
        ))
    }}
</div>