{% form_theme form '@OwlAdmin/shared/form_theme.html.twig' %}

<div {{ attributes }} data-form-target="live">
    {{ 
        form_start(
            form, 
            {
                'attr': {
                    'class': 'ui loadable form',
                    'novalidate': 'novalidate',
                    'id': form.vars.id,
                    'data-form-target':'form'
                }
            }
        ) 
    }}
    {% if hookable_metadata.configuration.method is defined %}
        <input type="hidden" name="_method" value="{{ hookable_metadata.configuration.method }}" />
    {% endif %}
    {{ form_errors(form) }}
    {{ form_widget(form._token) }}

    {{ form_row(form.status) }}
    {{ form_row(form.comment) }}

    {{ form_end(form, {render_rest: false}) }}
</div>
