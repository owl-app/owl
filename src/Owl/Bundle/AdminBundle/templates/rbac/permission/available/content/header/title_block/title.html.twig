{% import '@OwlAdmin/shared/helper/header.html.twig' as header %}

{% set header = hookable_metadata.configuration.title|default('owl.ui.list_permission_availables_in_system') %}

{% set icon = hookable_metadata.configuration.icon|default('flowbite:lock-outline') %}
{% set subheader = hookable_metadata.configuration.subheader|default(null) %}
{% set test_attribute = hookable_metadata.configuration.owl_test_html_attribute is defined ? owl_test_html_attribute(hookable_metadata.configuration.owl_test_html_attribute) : null %}

<div class="col-12 col-md" {{ test_attribute }}>
    <div class="d-md-flex gap-2 align-items-center">
        {{ header.h1(header|trans , icon, subheader|trans) }}
    </div>
</div>
