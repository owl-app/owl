{% extends '@OwlAdmin/shared/layout/base.html.twig' %}

{% set prefixes = [
    'owl_admin.permission_available'
] %}

{% block title %}{{ 'owl.ui.list_permission_availables_in_system' }} | {{ parent() }}{% endblock %}

{% block body_class %}layout-fluid{% endblock %}

{% block body %}
    {% hook 'index' with { _prefixes: prefixes, configuration, forms, metadata} %}
{% endblock %}

{% block modal %}
    {% hook 'index#modals' with { _prefixes: prefixes, configuration, forms, metadata } %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% hook 'index#stylesheets' with { _prefixes: prefixes } %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% hook 'index#javascripts' with { _prefixes: prefixes } %}
{% endblock %}
