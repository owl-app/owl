{% extends '@OwlAdmin/shared/layout/base.html.twig' %}

{% set prefixes = [
    'owl_admin.role_permissions'
] %}

{% set header = configuration.vars.header|default() %}

{% block title %}{{ header|trans }} | {{ parent() }}{% endblock %}

{% block body_class %}layout-fluid{% endblock %}

{% block body %}
    {% hook 'index' with { _prefixes: prefixes, role, configuration, forms, metadata} %}
{% endblock %}

{% block modal %}
    {% hook 'index#modals' with { _prefixes: prefixes, role, configuration, forms, metadata } %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% hook 'index#stylesheets' with { _prefixes: prefixes } %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% hook 'index#javascripts' with { _prefixes: prefixes } %}
{% endblock %}
