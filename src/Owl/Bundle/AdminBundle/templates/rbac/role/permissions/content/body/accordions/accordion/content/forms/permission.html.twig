{% set form = hookable_metadata.context.form %}
{% set configuration = hookable_metadata.configuration %}
{% set messages = {
    assign: {
        success: configuration.messages.assign.success|default('owl.ui.permissions_added_successfully')|trans,
        error: configuration.messages.assign.error|default('owl.ui.error_while_adding_permissions')|trans,
    },
    revoke: {
        success: configuration.messages.revoke.success|default('owl.ui.permission_removed_successfully')|trans,
        error: configuration.messages.revoke.error|default('owl.ui.error_while_removing_permission')|trans,
    }
} %}

<div>
    {{ 
        form_start(form, {
            'name' : hookable_metadata.context.name~'-'~form.vars.value.name ,
            attr: {
                'data-controller': 'permission',
                'data-action': 'permission:changed@window->toast#show',
                'data-permission-assign-url-value': path(configuration.path.assign.route, configuration.path.assign.params),
                'data-permission-revoke-url-value': path(configuration.path.revoke.route, configuration.path.revoke.params),
                'data-permission-messages-value': messages|json_encode,
            }
        }) }}
    <div class="form-check form-switch">
        <input {{form.vars.checked}} type="checkbox" class="form-check-input" data-permission-target="checkbox">
        <label class="checkbox-switch form-check-label">{{form.vars.description_permission|trans}}</label>
    </div>
    {{ form_row(form.name, { 'id' : form.vars.value.name~'-name'}) }}
    {{ form_row(form.type, { 'id' : form.vars.value.name~'-type'}) }}
    {{ form_row(form._csrf_token, { 'id' : form.vars.value.name~'-_csrf_token'}) }}
    {{ form_end(form, {'render_rest': false}) }}
</div>