{% set route = options.link.url|default(options.link.route) %}
{% set path = options.link.url|default(path(options.link.route|default(grid.requestConfiguration.getRouteName('show')), options.link.parameters|default({'id': data.id}))) %}

{% if is_granted(route) and (data.registration is null or data.registration.status == 'accepted') %}
    <a href="{{ path }}" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="{{ action.label|trans }}">
        {{ ux_icon(options.icon|default('tabler:pencil')) }}
    </a>
{% endif %}
