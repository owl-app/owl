{% set route = options.link.url|default(options.link.route|default(grid.requestConfiguration.getRouteName('update'))) %}
{% set path = options.link.url|default(path(route, options.link.parameters|default({'id': data.id}))) %}

{% if is_granted(route) and (data.registration is null or data.registration.status == 'accepted') %}
    <a href="{{ path }}" class="btn btn-icon" data-bs-toggle="tooltip" data-bs-title="{{ 'owl.ui.edit'|trans }}">
        {{ ux_icon(action.icon|default('flowbite:pen-outline')) }}
    </a>
{% endif %}

