{% import '@OwlAdmin/shared/helper/button.html.twig' as buttons %}

{% set status = data.registration.status|default(null) %}

{% if (status is not null) %}
    {% if status == 'new' %}
        {% set statusColor = 'yellow' %}
    {% elseif status == 'accepted' %}
        {% set statusColor = 'green' %}
    {% elseif status == 'rejected' %}
        {% set statusColor = 'red' %}
    {% endif %}

    {% set route = options.link.url|default(options.link.route) %}
    {% set path = options.link.url|default(path(options.link.route|default(grid.requestConfiguration.getRouteName('show')), options.link.parameters|default([]))) %}
    {% set label = ('owl.ui.registration_' ~ status)|trans %}

    {% if is_granted(route) and (data.registration is not null) %}
        {{ 
            buttons.modal(
                path('owl_admin_confirm_registration', { id: data.id }),
                '',
                label,
                '',
                options.icon|default('flowbite:user-add-outline'),
                'btn-' ~ statusColor,
                options.disabled|default(false),
                { size: 'xl' }
            )
        }}
    {% endif %}
{% endif %}
