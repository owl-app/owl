{% import '@OwlAdmin/shared/helper/header.html.twig' as header %}

{% set header = hookable_metadata.configuration.title|default('owl.ui.permissions') %}

{% set icon = hookable_metadata.configuration.icon|default('flowbite:check-plus-circle-outline') %}
{% set subheader = hookable_metadata.configuration.subheader|default(null) %}
{% set test_attribute = hookable_metadata.configuration.owl_test_html_attribute is defined ? sylius_test_html_attribute(hookable_metadata.configuration.owl_test_html_attribute) : null %}

<div class="col-12 col-md" {{ test_attribute }}>
    <div class="d-md-flex gap-2 align-items-center">
        {{ header.h1(header|trans ~ ': ' ~ hookable_metadata.context.user.displayName , icon, subheader|trans) }}
    </div>
</div>
