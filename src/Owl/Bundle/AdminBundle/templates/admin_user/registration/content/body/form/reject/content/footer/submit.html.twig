{% import '@OwlAdmin/shared/helper/button.html.twig' as button %}

<div class="w-100 align-items-center d-flex justify-content-center">
    {{ 
        button.default({
            text: 'owl.ui.reject_registration'|trans,
            class: 'btn btn-red w-50',
            attr: {
                'data-action': 'form:saved@window->modal#close form#save',
                'data-form-target': 'action',
                'data-form-url-param': path('owl_admin_partial_admin_user_reject_registration', {'id': hookable_metadata.context.resource.id}),
                'data-form-method-param': 'PUT',
                'data-form-save-action-param': 'referer',
                'data-form-disable-all-buttons-param': ['.owl-modal .btn-close', '.owl-modal [data-form-target="action"]']|json_encode
            }
        })
    }}
</div>