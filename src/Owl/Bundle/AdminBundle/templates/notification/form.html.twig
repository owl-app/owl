{% form_theme form '@OwlAdmin/shared/form_theme.html.twig' %}

<div {{ attributes }} data-form-target="live">
    {{ 
        form_start(
            form, 
            {
                'attr': {
                    'class': 'ui loadable form',
                    'novalidate': 'novalidate',
                    'id': form.vars.id,
                    'data-form-target':'form'
                }
            }
        ) 
    }}
    {{ form_errors(form) }}
    {{ form_widget(form._token) }}

    <div class="row">
        <div class="col-lg-8 col-sm-12">
            {{ form_row(form.subject) }}
        </div>
        <div class="col-lg-4 col-sm-12">
            {{ form_row(form.dateIssue) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.currentFrom) }}
        </div>
        <div class="col">
            {{ form_row(form.currentTo) }}
        </div>
        <div class="col">
            {{ form_row(form.assignedGroup) }}
        </div>
    </div>
    <div class="col-12">
        {{ form_row(form.description) }}
    </div>

    {{ form_end(form, {render_rest: false}) }}
</div>
