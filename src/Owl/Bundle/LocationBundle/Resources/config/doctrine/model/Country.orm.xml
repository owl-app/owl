<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Owl\Component\Location\Model\Country" table="owl_country">
        <indexes>
            <index columns="code" />
        </indexes>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="code" column="code" type="string" length="2" unique="true"/>
        <field name="enabled" column="enabled" type="boolean" />

        <one-to-many field="provinces" target-entity="Owl\Component\Location\Model\ProvinceInterface" mapped-by="country" orphan-removal="true">
            <cascade>
                <cascade-all/>
            </cascade>
            <order-by>
                <order-by-field name="name" />
                <order-by-field name="id" />
            </order-by>
        </one-to-many>
    </mapped-superclass>

</doctrine-mapping>
