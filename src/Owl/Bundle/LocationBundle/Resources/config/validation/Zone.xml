<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Owl\Component\Location\Model\Zone">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">code</option>
            <option name="message">owl.zone.code.unique</option>
            <option name="groups">owl</option>
        </constraint>
        <property name="code">
            <constraint name="NotBlank">
                <option name="message">owl.zone.code.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Regex">
                <option name="message">owl.zone.code.regex</option>
                <option name="pattern">/^[\w-]*$/</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Length">
                <option name="max">255</option>
                <option name="maxMessage">owl.zone.code.max_length</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <property name="type">
            <constraint name="Choice">
                <option name="callback">getTypes</option>
                <option name="message">owl.zone.type.invalid</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <property name="name">
            <constraint name="NotBlank">
                <option name="message">owl.zone.name.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Length">
                <option name="min">2</option>
                <option name="max">255</option>
                <option name="minMessage">owl.zone.name.min_length</option>
                <option name="maxMessage">owl.zone.name.max_length</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <getter property="members">
            <constraint name="Sylius\Bundle\ResourceBundle\Validator\Constraints\UniqueWithinCollectionConstraint">
                <option name="message">owl.zone_member.unique</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Owl\Bundle\LocationBundle\Validator\Constraints\ZoneCannotContainItself">
                <option name="message">owl.zone_member.cannot_be_the_same_as_zone</option>
                <option name="groups">
                    <value>owl</value>
                </option>
            </constraint>
            <constraint name="Valid" />
            <constraint name="Count">
                <option name="min">1</option>
                <option name="minMessage">owl.zone.members.min_count</option>
                <option name="groups">owl</option>
            </constraint>
        </getter>
    </class>
</constraint-mapping>
