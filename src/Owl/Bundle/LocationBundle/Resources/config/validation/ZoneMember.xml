<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Owl\Component\Location\Model\ZoneMember">
        <constraint name="Owl\Bundle\LocationBundle\Validator\Constraints\ZoneMemberGroup">
            <option name="groups">owl</option>
        </constraint>

        <property name="code">
            <constraint name="NotBlank">
                <option name="message">owl.zone_member.code.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Regex">
                <option name="message">owl.zone_member.code.regex</option>
                <option name="pattern">/^[\w-]*$/</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Length">
                <option name="max">255</option>
                <option name="maxMessage">owl.zone_member.code.max_length</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
