<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Owl\Component\Location\Model\Country">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">code</option>
            <option name="message">owl.country.code.unique</option>
            <option name="groups">owl</option>
        </constraint>
        <property name="code">
            <constraint name="Country">
                <option name="message">owl.country.code.country</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="NotBlank">
                <option name="message">owl.country.code.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <property name="provinces">
            <constraint name="Owl\Bundle\LocationBundle\Validator\Constraints\UniqueProvinceCollection">
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Valid" />
        </property>
    </class>
</constraint-mapping>
