<?xml version="1.0" encoding="UTF-8"?>

<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <imports>
        <import resource="services/*.xml" />
    </imports>

    <services>
        <service id="owl.provider.province_naming" class="Owl\Component\Location\Provider\ProvinceNamingProvider" lazy="true">
            <argument type="service" id="owl.repository.province" />
        </service>
        <service id="Owl\Component\Location\Provider\ProvinceNamingProviderInterface" alias="owl.provider.province_naming" />

        <service id="owl.converter.country_name" class="Owl\Component\Location\Converter\CountryNameConverter" />
        <service id="Owl\Component\Location\Converter\CountryNameConverterInterface" alias="owl.converter.country_name" />

        <service id="owl.twig.extension.country_name" class="Owl\Bundle\LocationBundle\Twig\CountryNameExtension">
            <argument type="string" id="isoCode" />
            <tag name="twig.extension"/>
        </service>

        <service id="owl.twig.extension.province_naming" class="Owl\Bundle\LocationBundle\Twig\ProvinceNamingExtension">
            <argument type="service" id="owl.provider.province_naming" />
            <argument type="string" id="provinceCode" />
            <tag name="twig.extension" />
        </service>
    </services>
</container>
