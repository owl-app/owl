<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Owl\Component\Invoice\Model\BaseInvoice">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">
                <value>fullNumber</value>
            </option>
            <option name="message">owl.invoice.number.unique</option>
            <option name="groups">owl</option>
        </constraint>

        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">
                <value>number</value>
            </option>
            <option name="message">owl.invoice.number.unique</option>
            <option name="groups">owl</option>
        </constraint>

        <property name="number">
            <constraint name="NotBlank">
                <option name="message">owl.invoice.number.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>

        <property name="issueDate">
            <constraint name="NotBlank">
                <option name="message">owl.common.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>

        <property name="transactionDate">
            <constraint name="NotBlank">
                <option name="message">owl.common.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>

        <property name="duePaymentDate">
            <constraint name="NotBlank">
                <option name="message">owl.common.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
