<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Owl\Component\Invoice\Model\Taxation\TaxRate">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity" >
            <option name="fields">code</option>
            <option name="message">owl.tax_rate.code.unique</option>
            <option name="groups">owl</option>
        </constraint>
        <property name="code">
            <constraint name="NotBlank">
                <option name="message">owl.tax_rate.code.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Regex">
                <option name="message">owl.tax_rate.code.regex</option>
                <option name="pattern">/^[\w-]*$/</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Length">
                <option name="max">255</option>
                <option name="maxMessage">owl.tax_rate.code.max_length</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <property name="name">
            <constraint name="NotBlank">
                <option name="message">owl.tax_rate.name.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="Length">
                <option name="min">2</option>
                <option name="max">255</option>
                <option name="minMessage">owl.tax_rate.name.min_length</option>
                <option name="maxMessage">owl.tax_rate.name.max_length</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <property name="endDate">
            <constraint name="GreaterThan">
                <option name="propertyPath">startDate</option>
                <option name="message">owl.tax_rate.date.greater_than_start_date</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
        <property name="zones">
            <constraint name="Count">
                <option name="min">1</option>
                <option name="minMessage">owl.tax_rate.zones.min_length</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
