<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd">
    <class name="Owl\Component\Invoice\Model\LineItem">
        <property name="name">
            <constraint name="NotBlank">
                <option name="message">owl.invoice.line_item.name.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>

        <property name="quantity">
            <constraint name="NotBlank">
                <option name="message">owl.common.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="GreaterThan">
                <option name="value">0</option>
                <option name="groups">owl</option>
            </constraint>
        </property>

        <property name="unit">
            <constraint name="NotBlank">
                <option name="message">owl.common.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>

        <property name="taxRate">
            <constraint name="NotBlank">
                <option name="message">owl.common.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
        </property>

        <property name="unitPrice">
            <constraint name="NotBlank">
                <option name="message">owl.common.not_blank</option>
                <option name="groups">owl</option>
            </constraint>
            <constraint name="GreaterThan">
                <option name="value">0</option>
                <option name="groups">owl</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
