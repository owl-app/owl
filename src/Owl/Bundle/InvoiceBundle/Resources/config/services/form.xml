<?xml version="1.0" encoding="UTF-8"?>

<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <parameters>
        <parameter key="owl.form.type.invoice.validation_groups" type="collection">
            <parameter>owl</parameter>
        </parameter>
        <parameter key="owl.form.type.invoice_serie.validation_groups" type="collection">
            <parameter>owl</parameter>
        </parameter>
        <parameter key="owl.form.type.invoice_tax_rate.validation_groups" type="collection">
            <parameter>owl</parameter>
        </parameter>
        <parameter key="owl.form.type.invoice_line_item.validation_groups" type="collection">
            <parameter>owl</parameter>
        </parameter>
    </parameters>

    <services>
        <defaults public="true" />

        <service id="owl.form.type.invoice" class="Owl\Bundle\InvoiceBundle\Form\Type\InvoiceType">
            <argument>%owl.model.invoice.class%</argument>
            <argument>%owl.model.invoice_serie.class%</argument>
            <argument>%owl.form.type.invoice.validation_groups%</argument>

            <tag name="form.type" />
        </service>

        <service id="owl.form.type.invoice_serie" class="Owl\Bundle\InvoiceBundle\Form\Type\InvoiceSerieType">
            <argument>%owl.model.invoice_serie.class%</argument>
            <argument>%owl.form.type.invoice_serie.validation_groups%</argument>

            <tag name="form.type" />
        </service>

        <service id="owl.form.type.invoice_type_choice" class="Owl\Bundle\InvoiceBundle\Form\Type\InvoiceTypeChoiceType">
            <tag name="form.type" />
        </service>

        <service id="sylius.form.type.invoice_sequence_strategy_choice" class="Owl\Bundle\InvoiceBundle\Form\Type\InvoiceSequenceIncrementStrategyChoiceType">
            <argument>%owl.invoice.sequence_increment_strategies%</argument>
            <tag name="form.type" />
        </service>

        <service id="owl.form.type.invoice_payment_method_choice" class="Owl\Bundle\InvoiceBundle\Form\Type\Payment\InvoicePaymentMethodChoiceType">
            <tag name="form.type" />
        </service>

        <service id="owl.form.type.invoice_tax_rate" class="Owl\Bundle\InvoiceBundle\Form\Type\Taxation\TaxRateType">
            <argument>%owl.model.invoice_tax_rate.class%</argument>
            <argument>%owl.form.type.invoice_tax_rate.validation_groups%</argument>
            <argument type="service" id="owl.form.subscriber.build_country" />
            <tag name="form.type" />
        </service>

        <service id="owl.form.type.invoice_line_item" class="Owl\Bundle\InvoiceBundle\Form\Type\LineItemType">
            <argument>%owl.model.invoice_line_item.class%</argument>
            <argument>%owl.form.type.invoice_line_item.validation_groups%</argument>
            <tag name="form.type" />
        </service>
    </services>
</container>
