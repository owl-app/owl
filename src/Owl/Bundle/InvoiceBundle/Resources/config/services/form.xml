<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <parameters>
        <parameter key="owl.form.type.invoice.validation_groups" type="collection">
            <parameter>owl</parameter>
        </parameter>
    </parameters>

    <services>
        <defaults public="true" />

        <service id="owl.form.type.invoice" class="Owl\Bundle\InvoiceBundle\Form\Type\InvoiceType">
            <argument>%owl.model.invoice.class%</argument>
            <argument>%owl.form.type.invoice.validation_groups%</argument>

            <tag name="form.type" />
        </service>
    </services>
</container>
