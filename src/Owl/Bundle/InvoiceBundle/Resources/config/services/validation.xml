<?xml version="1.0" encoding="UTF-8"?>

<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="owl.validator.valid_unique_default_serie" class="Owl\Bundle\InvoiceBundle\Validator\UniqueDefaultSerieConstraintValidator">
            <argument type="service" id="owl.repository.invoice_serie" />
            <tag name="validator.constraint_validator" alias="owl_unique_default_serie_validator" />
        </service>
    </services>
</container>
