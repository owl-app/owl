<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service
            id="owl.twig.ux.component_template_finder"
            class="Owl\Bundle\UiBundle\Twig\Ux\ComponentTemplateFinder"
            decorates="ux.twig_component.component_template_finder"
        >
            <argument type="service" id=".inner" />
            <argument type="service" id="twig.loader.native_filesystem" />
            <argument>%owl_ui.twig_ux.anonymous_component_template_prefixes%</argument>
        </service>
    </services>
</container>
