<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service
            id="owl.twig.error_renderer"
            class="Owl\Bundle\UiBundle\Twig\ErrorRenderer\TwigErrorRenderer"
            decorates="twig.error_renderer.html"
            decoration-priority="64"
        >
            <argument type="service" id=".inner"/>
            <argument type="service" id="twig" />
            <argument type="tagged_iterator" tag="owl.twig.error_template_finder" />
            <argument>%kernel.debug%</argument>
        </service>
    </services>
</container>
