<?xml version="1.0" encoding="UTF-8"?>

<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="owl.twig.extension.percentage" class="Owl\Bundle\UiBundle\Twig\PercentageExtension">
            <tag name="twig.extension" />
        </service>

        <service id="owl.twig.extension.merge_recursive" class="Owl\Bundle\UiBundle\Twig\MergeRecursiveExtension">
            <tag name="twig.extension" />
        </service>

        <service id="owl.twig.extension.redirect_path" class="Owl\Bundle\UiBundle\Twig\RedirectPathExtension">
            <argument type="service" id="sylius.grid.filter_storage" />
            <argument type="service" id="router" />
            <tag name="twig.extension" />
        </service>

        <service id="owl.twig.extension.test_form_attribute" class="Owl\Bundle\UiBundle\Twig\Test\TestFormAttributeExtension">
            <argument>%kernel.environment%</argument>
            <argument>%kernel.debug%</argument>
            <tag name="twig.extension" />
        </service>

        <service id="owl.twig.extension.test_html_attribute" class="Owl\Bundle\UiBundle\Twig\Test\TestHtmlAttributeExtension">
            <argument>%kernel.environment%</argument>
            <argument>%kernel.debug%</argument>
            <tag name="twig.extension" />
        </service>
    </services>
</container>
