{% macro default(message, type, header, icon) %}
    <div class="alert d-flex align-items-center {{ type|default('alert-light') }}" {{ sylius_test_html_attribute('owl-flash-message', type) }}>
        {% if icon is not empty %}
            {{ ux_icon(icon, {'class': 'icon icon-md me-1'}) }}
        {% endif %}
        <div>
            {% if type is not empty %}
                <div class="fw-bold">
                    {{ header|default(type)|trans }}
                </div>
            {% endif %}
            {{ message|trans }}
        </div>
    </div>
{% endmacro %}

{% macro info(message, icon = 'flowbite:exclamation-circle-outline') %}
    {% import _self as messages %}
    {{ messages.default(message, 'alert-info', 'owl.ui.info', icon) }}
{% endmacro %}

{% macro success(message) %}
    {% import _self as messages %}
    {{ messages.default(message, 'alert-success', 'owl.ui.success') }}
{% endmacro %}

{% macro error(message) %}
    {% import _self as messages %}
    {{ messages.default(message, 'alert-danger', 'owl.ui.error') }}
{% endmacro %}
