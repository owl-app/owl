{
    "name": "owl/contractor-bundle",
    "type": "symfony-bundle",
    "description": "Contractors management for Symfony projects.",
    "keywords": [
        "owl",
        "contractors"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Paweł Kęska",
            "email": "projekty@pawelkeska.eu"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "owl/locale": "^1.0",
        "sylius/resource-bundle": "^1.7",
        "symfony/framework-bundle": "^4.4 || ^5.2",
    },
    "conflict": {
        "twig/twig": "^1.0"
    },
    "require-dev": {
        "doctrine/orm": "^2.7",
        "ocramius/proxy-manager": "^2.2",
        "phpunit/phpunit": "^8.5",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "symfony/browser-kit": "^4.4 || ^5.2",
        "symfony/dependency-injection": "^4.4 || ^5.2",
        "twig/twig": "^2.12"
    },
    "config": {
        "bin-dir": "bin"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.9-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Owl\\Bundle\\ContractorBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Owl\\Bundle\\ContractorBundle\\spec\\": "spec/"
        },
        "classmap": [
            "test/app/AppKernel.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
