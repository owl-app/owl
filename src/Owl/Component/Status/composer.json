{
    "name": "owl/status",
    "type": "library",
    "description": "PHP component for managing statuses.",
    "keywords": [
        "status",
        "owl"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Paweł Kęska",
            "homepage": "https://pawelkeska.eu"
        }
    ],
    "require": {
        "php": "^8.2",
        "sylius/resource": "^1.13"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "bin-dir": "bin"
    },
    "autoload": {
        "psr-4": {
            "Owl\\Component\\Status\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Owl\\Component\\Status\\": "Tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
