<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="true" />

        <service id="owl.behat.page.admin.user.create" class="Owl\Behat\Page\Admin\User\CreatePage" parent="owl.behat.page.admin.crud.create" public="false">
            <argument type="string">owl_admin_admin_user_create</argument>
        </service>
        <service id="owl.behat.page.admin.user.index" class="Owl\Behat\Page\Admin\Crud\IndexPage" parent="owl.behat.page.admin.crud.index" public="false">
            <argument type="string">owl_admin_admin_user_index</argument>
        </service>
        <service id="owl.behat.page.admin.user.update" class="Owl\Behat\Page\Admin\User\UpdatePage" parent="owl.behat.page.admin.crud.update" public="false">
            <argument type="string">owl_admin_admin_user_update</argument>
        </service>
    </services>
</container>
