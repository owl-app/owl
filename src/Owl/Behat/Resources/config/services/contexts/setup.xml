<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="owl.behat.context.setup.admin_user" class="Owl\Behat\Context\Setup\AdminUserContext">
            <argument type="service" id="owl.behat.shared_storage" />
            <argument type="service" id="owl.fixture.example_factory.admin_user" />
            <argument type="service" id="owl.repository.admin_user" />
            <argument type="service" id="owl_rbac.manager" />
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="behat.mink.parameters" />
        </service>

        <service id="owl.behat.context.setup.rbac_role" class="Owl\Behat\Context\Setup\RbacRoleContext">
            <argument type="service" id="owl.behat.shared_storage" />
            <argument type="service" id="owl.fixture.example_factory.rbac_role" />
            <argument type="service" id="owl.repository.rbac_role" />
            <argument type="service" id="owl_rbac.manager" />
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="behat.mink.parameters" />
        </service>

        <service id="owl.behat.context.setup.admin_security" class="Owl\Behat\Context\Setup\AdminSecurityContext">
            <argument type="service" id="owl.behat.shared_storage" />
            <argument type="service" id="owl.behat.admin_security" />
            <argument type="service" id="owl.fixture.example_factory.admin_user" />
            <argument type="service" id="owl.repository.admin_user" />
        </service>

        <service id="owl.behat.context.setup.locale" class="Owl\Behat\Context\Setup\LocaleContext">
            <argument type="service" id="owl.behat.shared_storage" />
            <argument type="service" id="owl.factory.locale" />
            <argument type="service" id="owl.repository.locale" />
            <argument type="service" id="owl.manager.locale" />
        </service>

        <!-- <service id="owl.behat.context.setup.theme" class="Owl\Behat\Context\Setup\ThemeContext">
            <argument type="service" id="owl.behat.shared_storage" />
            <argument type="service" id="owl.repository.theme" />
            <argument type="service" id="owl.manager.channel" />
            <argument type="service" id="Owl\Behat\ThemeBundle\Configuration\Test\TestThemeConfigurationManagerInterface" />
        </service> -->

    </services>
</container>
