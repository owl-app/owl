<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="owl.behat.context.hook.doctrine_orm" class="Owl\Behat\Context\Hook\DoctrineORMContext">
            <argument type="service" id="doctrine.orm.entity_manager" />
        </service>

        <service id="owl.behat.context.hook.session" class="Owl\Behat\Context\Hook\SessionContext">
            <argument type="service" id="request_stack" />
            <argument type="service" id="session.factory" on-invalid="null" />
        </service>


        <service id="owl.behat.context.hook.rbac_permissions" class="Owl\Behat\Context\Hook\RbacPermissionsContext">
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="owl.routes_permission_provider.rbac" />
            <argument type="service" id="owl.fixture.example_factory.rbac_permission" />
        </service>

        <service id="owl.behat.context.hook.test_theme" class="Owl\Behat\Context\Hook\TestThemeContext">
            <argument type="service" id="Sylius\Bundle\ThemeBundle\Configuration\Test\TestThemeConfigurationManagerInterface" />
        </service>

        <!-- <service id="owl.behat.context.hook.email_spool" class="Owl\Behat\Context\Hook\EmailSpoolContext">
            <argument type="service" id="owl.behat.email_checker"/>
            <argument type="service" id="filesystem" />
        </service> -->
    </services>
</container>
