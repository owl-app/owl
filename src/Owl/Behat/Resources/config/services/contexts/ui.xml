<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="owl.behat.context.ui.admin.dashboard" class="Owl\Behat\Context\Ui\Admin\DashboardContext">
            <argument type="service" id="owl.behat.page.admin.dashboard" />
        </service>

        <service id="owl.behat.context.ui.admin.login" class="Owl\Behat\Context\Ui\Admin\LoginContext">
            <argument type="service" id="owl.behat.page.admin.dashboard" />
            <argument type="service" id="owl.behat.page.admin.login" />
        </service>

        <service id="owl.behat.context.ui.admin.managing_users" class="Owl\Behat\Context\Ui\Admin\ManagingUsersContext">
            <argument type="service" id="owl.behat.page.admin.user.create" />
            <argument type="service" id="owl.behat.page.admin.user.index" />
            <argument type="service" id="owl.behat.page.admin.user.update" />
            <argument type="service" id="owl.behat.element.admin.top_bar" />
            <!-- <argument type="service" id="owl.behat.notification_checker" /> -->
            <argument type="service" id="owl.repository.admin_user"/>
            <argument type="service" id="owl.behat.shared_storage" />
        </service>

        <service id="owl.behat.context.ui.admin.notification" class="Owl\Behat\Context\Ui\Admin\NotificationContext">
            <argument type="service" id="owl.behat.notification_checker" />
            <argument type="service" id="owl.behat.java_script_test_helper" />
        </service>

        <service id="owl.behat.context.ui.browser" class="Owl\Behat\Context\Ui\BrowserContext">
            <argument type="service" id="owl.behat.element.browser" />
        </service>

    </services>
</container>
