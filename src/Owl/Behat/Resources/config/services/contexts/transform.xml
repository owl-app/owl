<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="owl.behat.context.transform.rbac_role" class="Owl\Behat\Context\Transform\RbacRoleContext">
            <argument type="service" id="owl.repository.rbac_role" />
        </service>

        <service id="owl.behat.context.transform.admin" class="Owl\Behat\Context\Transform\AdminUserContext">
            <argument type="service" id="owl.repository.admin_user" />
            <argument type="service" id="owl.behat.shared_storage" />
        </service>

        <service id="owl.behat.context.transform.date_time" class="Owl\Behat\Context\Transform\DateTimeContext">
        </service>

        <service id="owl.behat.context.transform.lexical" class="Owl\Behat\Context\Transform\LexicalContext">
        </service>

        <service id="owl.behat.context.transform.shared_storage" class="Owl\Behat\Context\Transform\SharedStorageContext">
            <argument type="service" id="owl.behat.shared_storage" />
        </service>

    </services>
</container>
