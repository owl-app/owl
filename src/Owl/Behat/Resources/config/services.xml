<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <imports>
        <import resource="services/contexts.xml" />
        <import resource="services/elements.xml" />
        <import resource="services/pages.xml" />
    </imports>

    <services>
        <defaults public="true" />

        <service id="owl.behat.cookie_setter" class="Owl\Behat\Service\Setter\CookieSetter" public="false">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="behat.mink.parameters" />
        </service>

        <service id="owl.behat.admin_security" class="Owl\Behat\Service\SecurityService" public="false">
            <argument type="service" id="request_stack" />
            <argument type="service" id="owl.behat.cookie_setter" />
            <argument type="string">admin</argument>
            <argument type="service" id="session.factory" on-invalid="null" />
        </service>

        <service id="Owl\Behat\Service\SessionManagerInterface" class="Owl\Behat\Service\SessionManager" public="false">
            <argument type="service" id="behat.mink" />
            <argument type="service" id="owl.behat.shared_storage" />
            <argument type="service" id="owl.behat.shop_security" />
        </service>

        <service id="owl.behat.shared_security" class="Owl\Behat\Service\SharedSecurityService" public="false">
            <argument type="service" id="owl.behat.admin_security" />
        </service>

        <service id="owl.behat.table_accessor" class="Owl\Behat\Service\Accessor\TableAccessor" public="false" />

        <service id="owl.behat.mocker" class="Owl\Behat\Service\Mocker\Mocker" public="false">
            <argument type="service" id="service_container" />
        </service>

        <service id="owl.behat.response_loader" class="Owl\Behat\Service\ResponseLoader" public="false" />

        <service id="owl.behat.current_page_resolver" class="Owl\Behat\Service\Resolver\CurrentPageResolver" public="false">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="router" />
        </service>

        <service id="owl.behat.notification_accessor" class="Owl\Behat\Service\Accessor\NotificationAccessor" public="false">
            <argument type="service" id="behat.mink.default_session" />
        </service>

        <service id="owl.behat.notification_checker" class="Owl\Behat\Service\NotificationChecker" public="false">
            <argument type="service" id="owl.behat.notification_accessor" />
        </service>

        <service id="owl.behat.shared_storage" class="Owl\Behat\Service\SharedStorage" public="false"/>

        <service id="owl.behat.java_script_test_helper" class="Owl\Behat\Service\Helper\JavaScriptTestHelper" >
            <argument>100000</argument>
            <argument>7</argument>
        </service>
    </services>
</container>
